{
  "name": "@chaos-party/assets",
  "version": "0.0.0",
  "private": true,
  "description": "Assets mit Manifest (Herkunft, Lizenz, Budget): Figuren (GLB), Porträts (WebP) und Minispiel-Requisiten (GLB) aus Blender-Skripten, Klänge (MP3, CC0), Prüfskript.",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest.json": "./manifest.json",
    "./models/*": "./models/*",
    "./textures/*": "./textures/*",
    "./props": "./src/props.ts",
    "./sound-files": "./src/soundFiles.ts",
    "./sounds/*": "./sounds/*"
  },
  "scripts": {
    "generate": "blender/build-all.sh && blender/portraits-all.sh && blender/props-all.sh",
    "generate:portraits": "blender/portraits-all.sh",
    "import:polyhaven": "node src/import/polyhaven.ts",
    "check": "node src/check/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "generate:props": "blender/props-all.sh",
    "import:sounds": "node src/import/sounds.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.35.0",
    "@babylonjs/loaders": "^9.35.0",
    "@babylonjs/serializers": "^9.35.0",
    "@chaos-party/minigame-sdk": "workspace:*",
    "@types/node": "^22.20.5",
    "babylonjs-gltf2interface": "^9.35.0"
  }
}
